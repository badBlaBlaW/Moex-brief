{
  // Cloudflare deploys from this file. It lives at the repository root on
  // purpose: a git build runs `npx wrangler deploy` from the root by default,
  // so nothing has to be set for it to be found. Setting a root directory in
  // the dashboard would move the build somewhere this file is not, which is
  // the usual way these builds fail.
  //
  // The Worker in the dashboard must be named exactly as below, or a deploy
  // creates a second Worker instead of updating the first.
  //
  // Bindings and vars live here, because a git deploy is the source of truth
  // for them and would otherwise drop what was set by hand in the dashboard.
  // Secrets do NOT live here — TELEGRAM_TOKEN, OWNER_CHAT_ID and
  // WEBHOOK_SECRET are set in the dashboard and are never touched by a deploy.
  // This repository is public: no secret may ever be written in this file.
  // Must match the Worker's name in the dashboard exactly. It is moex-brief
  // there, so it is moex-brief here; with a different name a deploy quietly
  // creates a second Worker and serves the old code from the first.
  "name": "moex-brief",
  "main": "worker/worker.js",
  "compatibility_date": "2026-11-20",
  "workers_dev": true,

  // Without this, a deploy deletes every var not listed below before writing
  // the ones that are. Secrets survive a deploy regardless, so the three real
  // credentials are safe as long as they are added with type Secret — but a
  // value added as Text by mistake would vanish on the next push, and the bot
  // would stop with nothing in the logs to explain it. This is the safety net
  // for that mistake, not a substitute for using Secret.
  "keep_vars": true,

  "kv_namespaces": [
    {
      "binding": "STATE",
      "id": "ca42b016f6fe434dacdd1650a42f6cdb"
    }
  ],

  "vars": {
    "GITHUB_REPO": "badBlaBlaW/Moex-brief",
    "BRIEF_TIME": "08:47"
  },

  "observability": {
    "enabled": true
  }
}
